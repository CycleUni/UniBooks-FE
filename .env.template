# UniBooks-FE 環境變數範本
# 本檔僅列鍵名，不得含任何實際機密值。複製此檔為 .env 以供本地開發使用。
#
# 這些變數是由 scripts/set-env.js 在 build / test / serve 前讀取的
# （見 package.json 的 --env-file-if-exists=.env），不是 Angular CLI 的機制——
# Angular 本身沒有環境變數替換功能。該腳本會據此產生 src/environments/*.ts，
# 並改寫 public/_headers 裡的 CSP。部署時在 CI/CD 或平台後台設定同名變數即可。
#
# 命名規則：跨服務共用的值，名稱與 UniBooks-BE 完全相同（EDGE_CHAT_URL、
# R2_PUBLIC_URL），值也是同一個字串，方便整行複製；只有前端會用到的才加
# NG_APP_ 前綴。

# ---- 前端專用 ----

# 後端 API 網址 (必填)
# 用於所有與後端通訊的 API 請求。含 /api/v1 路徑，與 BE 的任何變數都不同，
# 因此保留 NG_APP_ 前綴。
# 開發環境通常為：http://127.0.0.1:8000/api/v1 (若跨裝置測試請改為電腦區網 IP)
# Cloudflare Pages 執行期也會讀這個變數：functions/[region]/book.ts 用它查書籍資料，
# 替分享連結的預覽（LINE、Facebook）寫入 og: 標籤。未設定時該 Function 原樣回傳頁面。
NG_APP_BACKEND_URL=

# Google Analytics 4 評估 ID (選填)
# 若留空則不會載入 GA 追蹤碼。格式如：G-XXXXXXXXXX
NG_APP_GA_MEASUREMENT_ID=

# SSR 允許的主機網域 (選填，多個網域請用半形逗號分隔)
# 預設為空時，只允許 angular.json 中寫死的 localhost。
# 部署至 Cloudflare 等平台時，請填入正式網域以允許 SSR。
# 範例：unibooksfe.pages.dev, *.unibooksfe.pages.dev, localhost, 127.0.0.1
NG_APP_ALLOWED_HOSTS=

# 是否強制執行完整的 CSP (選填，設為 1 才生效)
# 留空時：一組「零風險」指令（object-src / frame-ancestors / base-uri /
# form-action）仍會強制執行，完整政策則以 Report-Only 模式收集違規。
# 設為 1 時：完整政策改為強制執行——請先在已部署環境開 console 走過
# Google 登入、上傳照片、聊天室、書籍頁，確認沒有任何違規訊息再開啟，
# 否則 connect-src 若漏掉某個主機，App 會直接無法運作。
NG_APP_CSP_ENFORCE=

# ---- 與 UniBooks-BE 共用（同名同值，可直接複製）----

# CFEdgeChat 即時聊天服務網址
# 與 BE 的 EDGE_CHAT_URL 相同。前端執行期是向後端問這個值的，
# 這裡設定它只是為了組出 CSP 的 connect-src（含 wss://）。
EDGE_CHAT_URL=

# R2 物件儲存的公開網址
# 與 BE 的 R2_PUBLIC_URL 相同。同樣只用於組出 CSP 的 img-src——
# 圖片網址本身是後端回傳的，前端執行期不需要這個變數。
R2_PUBLIC_URL=
