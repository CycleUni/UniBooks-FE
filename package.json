{
  "name": "unibooks-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nodemon",
    "build": "node --env-file-if-exists=.env scripts/set-env.js && ng build",
    "watch": "node --env-file-if-exists=.env scripts/set-env.js && ng build --watch --configuration development",
    "test": "node --env-file-if-exists=.env scripts/set-env.js && ng test",
    "smoke": "node --env-file-if-exists=.env scripts/set-env.js && ng build --configuration smoke && wrangler pages dev dist/unibooks-fe/browser --port 8788"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/service-worker": "^22.1.6",
    "browser-image-compression": "^2.0.2",
    "html5-qrcode": "^2.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/pwa": "^22.1.8",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
